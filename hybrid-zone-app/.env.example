# Google Sign-In (see README for how to create these in Google Cloud Console).
# EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle at build time —
# fine here since OAuth client IDs are not secrets (unlike the client
# *secret*, which lives only on the backend in Railway, never in the app).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# RevenueCat — optional, leave unset and subscriptions/Upgrade screen just
# show "not set up yet"; nothing else in the app is affected. Public SDK
# keys, not secrets, so EXPO_PUBLIC_ is fine here. See "RevenueCat setup" in
# hybrid-zone-api/README.md.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
