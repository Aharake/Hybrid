# Google Sign-In (see README for how to create these in Google Cloud Console).
# EXPO_PUBLIC_-prefixed vars are inlined into the JS bundle at build time —
# fine here since OAuth client IDs are not secrets (unlike the client
# *secret*, which lives only on the backend in Railway, never in the app).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# On Android, Google Sign-In also needs an "Android" OAuth client in Google Cloud for
# package com.aleveatelier.hyvo with the SHA-1 of the signing key (the EAS keystore for
# test builds, and the Play App Signing key once the app is on Google Play). It has no
# value to paste here; it just has to exist in the same Google Cloud project.

# Google Maps for Android (route maps). Restrict the key to this app's package name and
# signing SHA-1. Without it the app draws the route as a simple line instead of a map.
# For cloud builds set it as an EAS environment variable, since .env is not uploaded.
EXPO_PUBLIC_GOOGLE_MAPS_ANDROID_KEY=

# RevenueCat — optional, leave unset and subscriptions/Upgrade screen just
# show "not set up yet"; nothing else in the app is affected. Public SDK
# keys, not secrets, so EXPO_PUBLIC_ is fine here. See "RevenueCat setup" in
# hybrid-zone-api/README.md.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
