# Postgres connection string — Railway provides this automatically when you add
# a Postgres plugin to your project (Variables tab -> DATABASE_URL). For local
# dev, point this at a local Postgres instance.
DATABASE_URL="postgresql://user:password@localhost:5432/hybrid_zone?schema=public"

# Random secret used to sign session tokens. Generate one with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-random-32+-char-secret"

# The public URL this API is reachable at (used by Better Auth for cookie/CORS
# config). Locally this is http://localhost:4000; on Railway it's the domain
# Railway assigns you (Settings -> Networking -> Generate Domain).
BETTER_AUTH_URL="http://localhost:4000"

# Comma-separated list of origins allowed to call this API (your Expo app's
# dev URL locally, and whatever it's served from in production).
CORS_ORIGINS="http://localhost:8081,exp://127.0.0.1:8081"

PORT=4000

# Google Sign-In — optional, leave unset to disable it entirely. See
# "Google Sign-In setup" in README.md for how to get these from Google
# Cloud Console. GOOGLE_CLIENT_SECRET belongs to the Web client only —
# the iOS/Android clients don't have secrets.
GOOGLE_CLIENT_ID_WEB=
GOOGLE_CLIENT_ID_IOS=
GOOGLE_CLIENT_ID_ANDROID=
GOOGLE_CLIENT_SECRET=
